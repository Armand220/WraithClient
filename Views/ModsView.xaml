<Page x:Class="WraithClient.Views.ModsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="DetailCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT ══ -->
        <DockPanel Grid.Column="0">

            <!-- Tab strip -->
            <Border DockPanel.Dock="Top" Padding="20,16,20,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                        <Button x:Name="TabBrowse"   Content="Browse"    Click="TabBrowse_Click"
                                Style="{StaticResource GhostBtn}" Padding="16,6" Margin="0,0,6,0"/>
                        <Button x:Name="TabInstalled" Content="Installed" Click="TabInstalled_Click"
                                Style="{StaticResource GhostBtn}" Padding="16,6"/>
                    </StackPanel>

                    <!-- Browse controls -->
                    <StackPanel x:Name="BrowseControls">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SearchBox" Style="{StaticResource TextBox}"
                                     KeyDown="SearchBox_KeyDown"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Search" Style="{StaticResource PrimaryBtn}"
                                        Margin="8,0,0,0" Padding="18,0" Height="36" Click="Search_Click"/>
                                <Button Content="📁 Mods Folder" Style="{StaticResource GhostBtn}"
                                        Margin="8,0,0,0" Padding="14,0" Height="36" Click="OpenFolder_Click"/>
                            </StackPanel>
                        </Grid>
                        <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" Height="30">
                            <StackPanel x:Name="CategoryPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status -->
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top"
                       Foreground="#444" FontSize="12" Margin="20,8,20,0"/>

            <!-- Browse list -->
            <ScrollViewer x:Name="BrowseScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="BrowseScroll_ScrollChanged">
                <StackPanel x:Name="ModList" Margin="20,8,20,20"/>
            </ScrollViewer>

            <!-- Installed list (hidden by default) -->
            <ScrollViewer x:Name="InstalledScroll" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel x:Name="InstalledList" Margin="20,8,20,20"/>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ RIGHT: detail ══ -->
        <Border x:Name="DetailBorder" Grid.Column="1" Background="#0D0D0D"
                BorderBrush="#1E1E1E" BorderThickness="1,0,0,0">
            <DockPanel>
                <Button DockPanel.Dock="Top" Content="✕  Close" HorizontalAlignment="Right"
                        Style="{StaticResource GhostBtn}" Margin="12,12,12,0" Padding="12,6"
                        Click="CloseDetail_Click"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="20,12,20,24"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
