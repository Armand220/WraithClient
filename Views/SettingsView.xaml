<Page x:Class="WraithClient.Views.SettingsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="Settings"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Configure the launcher and game."
                       Foreground="{StaticResource TextMutedBrush}"
                       FontSize="12" Margin="0,2,0,0"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <StackPanel MaxWidth="640">

                <!-- Game -->
                <TextBlock Text="GAME" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Username (offline)" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Used in cracked mode" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBox x:Name="UsernameBox" Grid.Column="1" Style="{StaticResource TextBox}"/>
                        </Grid>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Game Directory" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text=".wraith game folder" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBox x:Name="GameDirBox" Grid.Column="1" Style="{StaticResource TextBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostBtn}" Height="36" Padding="12,0" Click="BrowseDir_Click"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Java Path" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="Leave blank for auto" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                            </StackPanel>
                            <TextBox x:Name="JavaBox" Grid.Column="1" Style="{StaticResource TextBox}" Margin="0,0,8,0"/>
                            <Button Grid.Column="2" Content="Browse" Style="{StaticResource GhostBtn}" Height="36" Padding="12,0" Click="BrowseJava_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Memory -->
                <TextBlock Text="MEMORY" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Max RAM" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                            <Slider x:Name="RamSlider"
                                    Grid.Column="1"
                                    Minimum="512" Maximum="16384"
                                    TickFrequency="512"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource Slider}"
                                    ValueChanged="RamSlider_Changed"/>
                            <TextBlock x:Name="RamLabel"
                                       Grid.Column="2"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="13" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <StackPanel>
                            <TextBlock Text="JVM Arguments (optional)" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                            <TextBox x:Name="JvmBox" Style="{StaticResource TextBox}" Height="Auto" MinHeight="36" TextWrapping="Wrap" AcceptsReturn="True"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Window -->
                <TextBlock Text="WINDOW" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="FullscreenCheck" Content="Launch fullscreen"
                                  Style="{StaticResource Check}"
                                  Margin="0,0,0,12"
                                  Checked="Fullscreen_Changed" Unchecked="Fullscreen_Changed"/>
                        <Grid x:Name="ResGrid">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Resolution" Foreground="{StaticResource TextBrush}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <TextBox x:Name="WidthBox"  Grid.Column="1" Style="{StaticResource TextBox}"/>
                            <TextBlock Grid.Column="2" Text="x" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox x:Name="HeightBox" Grid.Column="3" Style="{StaticResource TextBox}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Launcher -->
                <TextBlock Text="LAUNCHER" Style="{StaticResource Label}" Margin="0,0,0,8"/>
                <Border Style="{StaticResource Card}" Margin="0,0,0,16">
                    <StackPanel>
                        <CheckBox x:Name="DiscordCheck"    Content="Discord Rich Presence"              Style="{StaticResource Check}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="KeepOpenCheck"   Content="Keep launcher open while in-game"   Style="{StaticResource Check}" Margin="0,0,0,10"/>
                        <CheckBox x:Name="InjectModCheck"  Content="Inject Wraith in-game mod on launch" Style="{StaticResource Check}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Save bar -->
        <Border Grid.Row="2"
                Margin="0,12,0,0"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="14,10">
            <Grid>
                <TextBlock x:Name="SaveStatus"
                           Foreground="{StaticResource TextMutedBrush}"
                           FontSize="11" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reset"      Style="{StaticResource GhostBtn}" Margin="0,0,10,0" Padding="14,8" Click="Reset_Click"/>
                    <Button Content="Save"       Style="{StaticResource PrimaryBtn}" Padding="20,8" Click="Save_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
