<Page x:Class="WraithClient.Views.LaunchProfilesView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition x:Name="EditCol" Width="0"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT: profile list ══ -->
        <DockPanel Grid.Column="0">

            <!-- Header -->
            <Border DockPanel.Dock="Top" Padding="24,20,24,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Launch Profiles" Foreground="#ECECEC" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock x:Name="SubText" Text="Manage your Minecraft launch configurations"
                                   Foreground="#444" FontSize="12" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="+ New Profile"
                            Style="{StaticResource PrimaryBtn}"
                            Padding="18,0" Height="36"
                            Click="NewProfile_Click"/>
                </Grid>
            </Border>

            <Rectangle DockPanel.Dock="Top" Height="1" Fill="#141414"/>

            <!-- List -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ProfileList" Margin="24,16,24,24"/>
            </ScrollViewer>
        </DockPanel>

        <!-- ══ RIGHT: edit panel ══ -->
        <Border x:Name="EditBorder" Grid.Column="1"
                Background="#0D0D0D" BorderBrush="#1E1E1E" BorderThickness="1,0,0,0">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,14,20,14"
                        BorderBrush="#1A1A1A" BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock x:Name="EditTitle" Text="Edit Profile"
                                   Foreground="#ECECEC" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="✕" HorizontalAlignment="Right"
                                Style="{StaticResource GhostBtn}" Padding="10,6"
                                Click="CloseEdit_Click"/>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="EditPanel" Margin="20,16,20,24"/>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Page>
