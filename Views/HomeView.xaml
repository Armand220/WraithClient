<Page x:Class="WraithClient.Views.HomeView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT ══ -->
        <Grid Grid.Column="0" Margin="24,20,12,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Play card -->
            <Border Grid.Row="0" Style="{StaticResource Card}" Padding="20">
                <StackPanel>

                    <!-- Cracked | Premium tab strip -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border x:Name="CrackedTab" Grid.Column="0"
                                CornerRadius="7" Cursor="Hand" Padding="0,10"
                                MouseLeftButtonDown="CrackedTab_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="CrackedTabLabel"
                                           Text="Cracked" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Offline mode"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PremiumTab" Grid.Column="2"
                                CornerRadius="7" Cursor="Hand" Padding="0,10"
                                MouseLeftButtonDown="PremiumTab_Click">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock x:Name="PremiumTabLabel"
                                           Text="Premium" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Microsoft account"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           FontSize="10" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Account row (changes per mode) -->
                    <Border Background="{StaticResource Surface2Brush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="20"
                            HorizontalAlignment="Left" Padding="10,4"
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="AccountDot" Width="7" Height="7"
                                     Fill="{StaticResource WarningBrush}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="AccountLabel"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- Cracked: username box -->
                    <StackPanel x:Name="UsernameRow" Margin="0,0,0,14">
                        <TextBlock Text="USERNAME" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                        <TextBox x:Name="UsernameBox" Style="{StaticResource TextBox}"/>
                    </StackPanel>

                    <!-- Version selector (both modes) -->
                    <TextBlock Text="VERSION" Style="{StaticResource Label}" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="VersionCombo"
                                  Grid.Column="0"
                                  Style="{StaticResource Combo}"
                                  SelectionChanged="VersionCombo_SelectionChanged"/>
                        <CheckBox x:Name="SnapshotsCheck"
                                  Grid.Column="2"
                                  Style="{StaticResource Check}"
                                  VerticalAlignment="Center"
                                  Checked="Snapshots_Changed"
                                  Unchecked="Snapshots_Changed"/>
                        <TextBlock Grid.Column="4" Text="Snapshots"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="12" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Play / Stop -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="PlayBtn"
                                Grid.Column="0"
                                Content="PLAY"
                                Style="{StaticResource PrimaryBtn}"
                                Height="46" FontSize="15" Padding="0"
                                Click="Play_Click"/>
                        <Button x:Name="StopBtn"
                                Grid.Column="2"
                                Content="STOP"
                                Style="{StaticResource GhostBtn}"
                                Height="46" Width="80" Padding="0"
                                Foreground="{StaticResource DangerBrush}"
                                Visibility="Collapsed"
                                Click="Stop_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Quick connect -->
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="QUICK CONNECT" Style="{StaticResource Label}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="IpBox"   Grid.Column="0" Style="{StaticResource TextBox}"/>
                        <TextBox x:Name="PortBox" Grid.Column="2" Style="{StaticResource TextBox}" Text="25565"/>
                        <Button Grid.Column="4"
                                Content="Set"
                                Style="{StaticResource GhostBtn}"
                                Height="36" Padding="14,0"
                                Click="Connect_Click"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Console -->
            <Border Grid.Row="4" Style="{StaticResource Card}" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <TextBlock Text="LAUNCH LOG" Style="{StaticResource Label}" VerticalAlignment="Center"/>
                        <Button Content="Copy" HorizontalAlignment="Right"
                                Style="{StaticResource GhostBtn}"
                                Padding="10,3,10,3" FontSize="11"
                                Click="CopyLog_Click"/>
                    </Grid>
                    <Border Grid.Row="1"
                            Background="#030303" CornerRadius="6"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            MinHeight="80">
                        <ScrollViewer x:Name="ConsoleScroll"
                                      VerticalScrollBarVisibility="Auto" Padding="8">
                            <TextBlock x:Name="ConsoleText"
                                       Foreground="#4EC94E"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="11" TextWrapping="Wrap"
                                       Text="Ready."/>
                        </ScrollViewer>
                    </Border>
                    <ProgressBar x:Name="LaunchProgress"
                                 Grid.Row="2"
                                 Height="2" Margin="0,8,0,0"
                                 Background="{StaticResource BorderBrush}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Minimum="0" Maximum="100"
                                 Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ══ RIGHT: status panel ══ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="12,20,20,20">
        <StackPanel>
            <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Text="STATUS" Style="{StaticResource Label}" Margin="0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Ellipse x:Name="StatusDot" Width="7" Height="7"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBlock x:Name="StatusText" Text="Ready"
                                       Foreground="{StaticResource SuccessBrush}" FontSize="11"/>
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Mode"      Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="InfoMode" Foreground="{StaticResource TextBrush}"     FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="Version"   Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="InfoVer"  Foreground="{StaticResource TextBrush}"     FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid Margin="0,0,0,5">
                        <TextBlock Text="RAM"        Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="InfoRam"  Foreground="{StaticResource TextBrush}"     FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid>
                        <TextBlock Text="Wraith Mod"  Foreground="{StaticResource TextMutedBrush}" FontSize="12"/>
                        <TextBlock x:Name="InfoMod"   Foreground="{StaticResource TextBrush}"     FontSize="12" HorizontalAlignment="Right"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16">
                <StackPanel>
                    <TextBlock Text="CHANGELOG" Style="{StaticResource Label}"/>

                    <TextBlock Text="v1.2  —  Cheats + HUD Update"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBlock Text="• Cheats tab — toggle Meteor Client, OpSec, LiquidBounce"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Multi-version cheat picker with custom dropdown"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Cheat version conflict detection"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Auto-injects + removes cheat jars on launch"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• HUD editor fullscreen — floating Reset / Done buttons"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Discord RPC toggle now works correctly"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,10" TextWrapping="Wrap"/>

                    <TextBlock Text="v1.0  —  Initial Release"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap"/>
                    <TextBlock Text="• 1.8.9 through latest Java Edition"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• In-game mod (Right Shift menu)"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Discord Rich Presence"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Premium + Cracked, any version"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,3" TextWrapping="Wrap"/>
                    <TextBlock Text="• Aikars JVM flags"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
