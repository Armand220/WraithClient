<Page x:Class="WraithClient.Views.CheatsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="Transparent"
      FontFamily="Segoe UI">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="20,16,20,12">
            <StackPanel>
                <TextBlock Text="Cheats" Foreground="#CCCCCC" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="Select a version and toggle to inject on next launch."
                           Foreground="#444" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Conflict banner -->
        <Border x:Name="ConflictBanner" DockPanel.Dock="Top"
                Background="#1A1010" BorderBrush="#FF5555" BorderThickness="0,1,0,1"
                Padding="20,8" Visibility="Collapsed">
            <TextBlock Text="⚠  Some enabled cheats support different Minecraft versions and may conflict."
                       Foreground="#FF7070" FontSize="12"/>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CheatList" Margin="20,4,20,20"/>
        </ScrollViewer>
    </DockPanel>
</Page>
