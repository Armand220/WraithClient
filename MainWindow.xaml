<Window x:Class="WraithClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Wraith Client"
        Width="1060" Height="660"
        MinWidth="860" MinHeight="560"
        WindowStyle="None"
        Background="#080808"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            BorderBrush="#222222"
            BorderThickness="1"
            ClipToBounds="True">
        <Border.Background>
            <SolidColorBrush Color="#080808"/>
        </Border.Background>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarCol" Width="72"/>   <!-- icon-only sidebar -->
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ Thin icon sidebar ══ -->
            <Border Grid.Column="0"
                    BorderBrush="#1A1A1A"
                    BorderThickness="0,0,1,0">
                <Border.Background>
                    <SolidColorBrush Color="#050505"/>
                </Border.Background>

                <DockPanel LastChildFill="False">

                    <!-- Logo mark — white W -->
                    <Border DockPanel.Dock="Top"
                            Height="72"
                            Margin="0,4,0,8">
                        <Image Source="pack://application:,,,/Assets/wraith_logo.png"
                               Width="52" Height="52"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Stretch="Uniform"/>
                    </Border>

                    <!-- Nav icons -->
                    <!-- Nav wrapper: highlight slides behind buttons -->
                    <Grid DockPanel.Dock="Top" Margin="0,8,0,0">
                        <Border x:Name="NavHighlight"
                                Width="72" Height="52"
                                VerticalAlignment="Top" HorizontalAlignment="Left"
                                Background="#1EFFFFFF">
                            <Border.RenderTransform>
                                <TranslateTransform x:Name="NavHighlightTransform" Y="0"/>
                            </Border.RenderTransform>
                        </Border>

                    <StackPanel>
                        <Button x:Name="NavHome"     Tag="Home"     Click="Nav_Click" ToolTip="Home"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoHome" Data="M10,20V14H14V20H19V12H22L12,3L2,12H5V20Z"
                                  Fill="White" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavProfile"  Tag="Profile"  Click="Nav_Click" ToolTip="Account"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoProfile" Data="M12,4A4,4 0 0,1 16,8A4,4 0 0,1 12,12A4,4 0 0,1 8,8A4,4 0 0,1 12,4M12,14C16.42,14 20,15.79 20,18V20H4V18C4,15.79 7.58,14 12,14Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavSettings" Tag="Settings" Click="Nav_Click" ToolTip="Settings"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoSettings" Data="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.03 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.68 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.03 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavProfiles" Tag="Profiles" Click="Nav_Click" ToolTip="Profiles"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoProfiles" Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 0,1 20,12A8,8 0 0,1 12,20A8,8 0 0,1 4,12A8,8 0 0,1 12,4M12,6A4,4 0 0,0 8,10A4,4 0 0,0 12,14A4,4 0 0,0 16,10A4,4 0 0,0 12,6M12,8A2,2 0 0,1 14,10A2,2 0 0,1 12,12A2,2 0 0,1 10,10A2,2 0 0,1 12,8M6.28,16.54C7.36,15.6 8.64,15 10,14.72V16.8C9.28,17.04 8.64,17.44 8.12,18L6.28,16.54M13.88,14.72C15.32,15 16.6,15.6 17.72,16.54L15.88,18C15.36,17.44 14.72,17.04 14,16.8L13.88,14.72Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavMods" Tag="Mods" Click="Nav_Click" ToolTip="Mods"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoMods" Data="M20.5,11H19V7C19,5.89 18.1,5 17,5H13V3.5A2.5,2.5 0 0,0 10.5,1A2.5,2.5 0 0,0 8,3.5V5H4A2,2 0 0,0 2,7V10.8H3.5C5,10.8 6.2,12 6.2,13.5C6.2,15 5,16.2 3.5,16.2H2V20A2,2 0 0,0 4,22H7.8V20.5C7.8,19 9,17.8 10.5,17.8C12,17.8 13.2,19 13.2,20.5V22H17A2,2 0 0,0 19,20V16H20.5A2.5,2.5 0 0,0 23,13.5A2.5,2.5 0 0,0 20.5,11Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavCheats" Tag="Cheats" Click="Nav_Click" ToolTip="Cheats"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoCheats" Data="M7,2V13H10V22L17,10H13L17,2H7Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                        <Button x:Name="NavLogs" Tag="Logs" Click="Nav_Click" ToolTip="Logs"
                                Style="{StaticResource IconNav}">
                            <Path x:Name="IcoLogs" Data="M14,17H7V15H14M17,13H7V11H17M17,9H7V7H17M19,3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3Z"
                                  Fill="#888" Stretch="Uniform" Width="18" Height="18"/>
                        </Button>
                    </StackPanel>
                    </Grid>

                    <!-- Bottom: version & discord -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                        <TextBlock x:Name="SidebarVer"
                                   Text="v1.0"
                                   Foreground="#333"
                                   FontSize="9"
                                   FontFamily="Segoe UI"
                                   HorizontalAlignment="Center"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                </DockPanel>
            </Border>

            <!-- ══ Content ══ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0"
                      MouseLeftButtonDown="TitleBar_MouseDown"
                      Background="Transparent">
                    <!-- Wraith logo image in title area -->
                    <Image Source="pack://application:,,,/Assets/logo.png"
                           Height="24"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0"
                           RenderOptions.BitmapScalingMode="HighQuality"
                           Stretch="Uniform"
                           IsHitTestVisible="False"/>

                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0">
                        <Button Content="—" Style="{StaticResource WinBtn}" Click="Minimize_Click"/>
                        <Button Content="□" Style="{StaticResource WinBtn}" Click="Maximize_Click" Margin="2,0"/>
                        <Button Content="✕" Style="{StaticResource WinBtnClose}" Click="Close_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Separator -->
                <Rectangle Grid.Row="0"
                           Height="1"
                           VerticalAlignment="Bottom"
                           Fill="#141414"
                           IsHitTestVisible="False"/>

                <!-- Page frame -->
                <Frame x:Name="PageFrame"
                       Grid.Row="1"
                       NavigationUIVisibility="Hidden"
                       Background="Transparent"/>
            </Grid>
        </Grid>
    </Border>
</Window>
